<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Small graspable cylinder: radius 2.5 cm (5 cm across, fits the 8 cm hand opening),
       height 10 cm, 0.2 kg. The model origin is its centre. -->
  <model name="cylinder">
    <link name="body">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>1.979e-4</ixx><iyy>1.979e-4</iyy><izz>6.25e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
