        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- Hard stop at the arm end: world x = 0.42..0.47, so the cube stops with its centre at x = 0.50 (= PICK_POSE x). -->
    <link name="stopper">
      <pose>-0.775 0 0.525 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="stopper_collision"><geometry><box><size>0.05 0.40 0.06</size></box></geometry></collision>
      <visual name="stopper_visual">
        <geometry><box><size>0.05 0.40 0.06</size></box></geometry>
        <material><ambient>0.9 0.6 0.0 1</ambient><diffuse>0.9 0.6 0.0 1</diffuse></material>
      </visual>
    </link>
    <joint name="frame_to_stopper" type="fixed"><parent>frame</parent><child>stopper</child></joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
