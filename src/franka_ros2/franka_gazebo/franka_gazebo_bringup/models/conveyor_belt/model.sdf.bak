<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="conveyor_belt">
    <static>false</static>

    <!-- fixed frame / table top: lengthened to match the belt panel -->
    <link name="frame">
      <pose>0 0 0.45 0 0 0</pose>
      <collision name="frame_collision">
        <geometry><box><size>1.6 0.4 0.05</size></box></geometry>
      </collision>
      <visual name="frame_visual">
        <geometry><box><size>1.6 0.4 0.05</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 4 support legs, repositioned under the new, longer frame -->
    <link name="leg_front_left">
      <pose>0.7 0.15 0.2125 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="leg_front_left_collision">
        <geometry><box><size>0.05 0.05 0.425</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="leg_front_left_visual">
        <geometry><box><size>0.05 0.05 0.425</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="leg_front_right">
      <pose>0.7 -0.15 0.2125 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="leg_front_right_collision">
        <geometry><box><size>0.05 0.05 0.425</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="leg_front_right_visual">
        <geometry><box><size>0.05 0.05 0.425</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="leg_back_left">
      <pose>-0.7 0.15 0.2125 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="leg_back_left_collision">
        <geometry><box><size>0.05 0.05 0.425</size></box></geometry>
