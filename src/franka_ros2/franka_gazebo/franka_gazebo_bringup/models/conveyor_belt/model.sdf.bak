        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- weld each leg rigidly to the frame -->
    <joint name="frame_to_leg_front_left" type="fixed">
      <parent>frame</parent>
      <child>leg_front_left</child>
    </joint>
    <joint name="frame_to_leg_front_right" type="fixed">
      <parent>frame</parent>
      <child>leg_front_right</child>
    </joint>
    <joint name="frame_to_leg_back_left" type="fixed">
      <parent>frame</parent>
      <child>leg_back_left</child>
    </joint>
    <joint name="frame_to_leg_back_right" type="fixed">
      <parent>frame</parent>
      <child>leg_back_right</child>
    </joint>


    <!-- ============================================================ -->
    <!-- Roller-bed conveyor v2: 58 small rollers (r = 12.5 mm, pitch 26.5 mm)   -->
    <!-- so a 6 cm cube always rests on 2+ rollers and cannot tumble.  -->
    <!-- Roller tops at z = 0.495. NEGATIVE velocity => top moves toward -X (the arm), as verified in Gazebo. -->
    <!-- Surface speed 0.15 m/s = 12.0 rad/s x 0.0125 m.                     -->
    <!-- ============================================================ -->

    <link name="roller_00">
      <pose>-0.7600 0 0.4825 1.5708 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.001337</ixx><iyy>0.001337</iyy><izz>0.00000781</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="roller_00_collision">
        <geometry><cylinder><radius>0.0125</radius><length>0.4</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="roller_00_visual">
        <geometry><cylinder><radius>0.0125</radius><length>0.4</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="roller_00_stripe">
        <pose>0.0115 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.006 0.4</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link>
    <joint name="roller_00_joint" type="revolute">
      <parent>frame</parent>
      <child>roller_00</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <link name="roller_01">
